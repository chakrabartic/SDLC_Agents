# Local environment template — copy to .env (git-ignored) or export in your shell.
# NEVER add API keys: Gemini is reached via Gemini Enterprise Agent Platform with ADC (GEMINI.md).
PM_AGENT_ENV=local
GOOGLE_GENAI_USE_VERTEXAI=true        # workspace rule (legacy name)
GOOGLE_GENAI_USE_ENTERPRISE=true      # current name (ADK docs: equivalent)
GOOGLE_CLOUD_PROJECT=chayan-genai-bb
GOOGLE_CLOUD_LOCATION=us-central1
# PM_AGENT_CONFIG=/path/to/pm_agent.yaml   # optional override of config/pm_agent.yaml
